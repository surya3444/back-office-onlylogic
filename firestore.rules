rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// OnlyLogic — working rules (deploy this one now).
//
//   firebase deploy --only firestore:rules
//   …or paste into Firebase console → Firestore → Rules → Publish.
//
// Access control for the back office is enforced in the app via roles. These
// rules keep the data safe at the boundary (only signed-in users, public site
// limited to creating bookings + reading products) while letting the first
// admin bootstrap without a chicken-and-egg lockout.
//
// Once you've signed in once (your admin account is created) AND added your
// team, you can switch to the stricter, role-aware rules in
// `firestore.rules.strict` for server-side per-module enforcement.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Marketing site: the lead form creates bookings; the storefront reads products.
    match /bookings/{id} {
      allow create: if true;
      allow read, update, delete: if signedIn();
    }
    match /products/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Client projects. The public portal reads a single project by its
    // unguessable id, submits its requirements form, and (via the payment
    // verify route) marks a milestone paid — both narrow, field-scoped updates.
    match /projects/{id} {
      allow read: if true;
      allow create, delete: if signedIn();
      allow update: if signedIn()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requirementForm'])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payment']);

      // Stage feedback — clients post from the portal; team manages from the app.
      match /comments/{cid} {
        allow read:   if true;
        allow create: if true;
        allow update, delete: if signedIn();
      }
    }

    // Our own in-house product builds — back-office only.
    match /ourProjects/{id} { allow read, write: if signedIn(); }

    // Collection-group read for stage feedback: the Projects Dashboard aggregates
    // comments across every project. (Per-project access is covered above; a
    // collectionGroup query needs its own rule and is back-office only.)
    match /{path=**}/comments/{cid} {
      allow read: if signedIn();
    }

    // Back-office collections — any signed-in account; the app's roles decide
    // what each member actually sees and can change.
    match /clients/{id}   { allow read, write: if signedIn(); }
    match /settings/{id}  { allow read, write: if signedIn(); }
    match /roles/{id}     { allow read, write: if signedIn(); }
    match /members/{id}   { allow read, write: if signedIn(); }

    match /auditLogs/{id} {
      allow create: if signedIn();
      allow read:   if signedIn();
      allow update, delete: if false; // audit trail is append-only
    }
  }
}
